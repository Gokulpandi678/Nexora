# ─── Database ──────────────────────────────────────────────────────────────
# Local (docker compose up -d db):
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/incident_tracker"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/incident_tracker"
# Supabase → Project Settings → Database → Connection string
#   DATABASE_URL: pooled (port 6543) with ?pgbouncer=true — used by the app
#   DIRECT_URL:   direct (port 5432) — used by migrations
# DATABASE_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Integration tests (npm test) only — not needed in production. Must point at a separate, disposable database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/incident_tracker_test"

# ─── Email (optional) ─────────────────────────────────────────────────────
# When RESEND_API_KEY is empty, notifications are still stored in-app (bell icon) and logged.
RESEND_API_KEY=""
EMAIL_FROM="Nexora <alerts@your-domain.com>"
# P1 incidents are emailed here immediately (e.g. an on-call distribution list). Optional.
ONCALL_EMAIL=""

# ─── App ───────────────────────────────────────────────────────────────────
# Used to build links in emails and the sign-out redirect. Required.
APP_URL="http://localhost:3000"
# API requests allowed per client IP per minute (per server instance)
RATE_LIMIT_PER_MINUTE="100"
# Set to "debug" to log every SQL query
LOG_LEVEL=""

# ─── Authentication (WorkOS AuthKit) ───────────────────────────────────────
# dashboard.workos.com → API Keys. Use the staging environment for local development.
WORKOS_API_KEY="sk_test_..."
WORKOS_CLIENT_ID="client_..."
# 32+ random characters used to encrypt the session cookie: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=""
# Must match a Redirect URI in WorkOS → Redirects
WORKOS_REDIRECT_URI="http://localhost:3000/auth/callback"
# Comma-separated emails that get the platform superadmin console (/superadmin)
SUPERADMIN_EMAILS="you@your-company.com"

# ─── Semantic matching (optional) ──────────────────────────────────────────
# With a key set, similar incidents are matched by meaning as well as keywords (needs pgvector,
# which Supabase has). Without one, matching is keyword-only. Voyage is used if both are set.
VOYAGE_API_KEY=""          # dash.voyageai.com → API keys (model voyage-3.5-lite)
OPENAI_API_KEY=""          # platform.openai.com (model text-embedding-3-small)
# EMBEDDINGS_PROVIDER="voyage"   # force a provider: voyage | openai
# EMBEDDINGS_MODEL=""            # override the model (must support 1024 dimensions)
